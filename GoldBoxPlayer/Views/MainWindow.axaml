<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GoldBoxPlayer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GoldBoxPlayer.Views"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="400"
        Width="640" Height="400"
        x:Class="GoldBoxPlayer.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="GoldBoxPlayer">
        <views:MainView x:Name="MainView"/>
</Window>
