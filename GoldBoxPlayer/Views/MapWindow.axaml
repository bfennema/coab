<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoldBoxPlayer.Views"
        x:Class="GoldBoxPlayer.Views.MapWindow"
        Title="Map"
        Width="440" Height="480"
        MinWidth="200" MinHeight="200"
        Background="Black">
  <Window.Styles>
    <Style Selector="Button.toolbtn">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.toolbtn:pointerover">
      <Setter Property="Background" Value="#5a5048"/>
    </Style>
    <Style Selector="Button.toolbtn:pressed">
      <Setter Property="Background" Value="#7a6a58"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="#1e1b17"
            Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="ZoomOutButton" Classes="toolbtn" Content="−" Width="28" Height="28"
                FontSize="18" Background="#3a3530" Padding="0,0,0,3" ToolTip.Tip="Zoom out (Ctrl+Scroll down)"/>
        <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                   Foreground="#bfa374" FontSize="13" MinWidth="45"
                   TextAlignment="Center"/>
        <Button x:Name="ZoomInButton" Classes="toolbtn" Content="+" Width="28" Height="28"
                FontSize="18" Background="#3a3530" Padding="0,0,0,3" ToolTip.Tip="Zoom in (Ctrl+Scroll up)"/>
        <Button x:Name="ZoomResetButton" Classes="toolbtn" Content="Reset" Height="28"
                FontSize="12" Background="#3a3530" Padding="8,0"
                ToolTip.Tip="Reset zoom to 100%"/>
        <Separator Width="1" Height="20" Background="#3a3530" Margin="4,0" />
        <CheckBox x:Name="ShowEventNumbersCheckBox" Content="Show Event Numbers" 
                  Foreground="#bfa374" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </Border>

    <!-- Scrollable map -->
    <ScrollViewer x:Name="MapScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="Black">
      <views:MapView x:Name="MapViewControl" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </ScrollViewer>
  </DockPanel>
</Window>
